<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Where a developer's own secrets live: outside the repository, per machine, in the user
      profile. It is what makes it possible for the committed appsettings files to hold no key
      at all and still be runnable.

        dotnet user-secrets set "Jwt:Key" "<a long random value>"

      run from this project's folder. This identifier is not a secret: it is the folder name
      the values are filed under, inside the user profile.
    -->
    <UserSecretsId>raphael-api-8f2c41d6-5a3b-4e19-9c07-2d6b8ae41f53</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="DotSwashbuckle.AspNetCore" Version="3.0.11" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raphael.Notification\Raphael.Notification.csproj" />
    <ProjectReference Include="..\Raphael.Shared\Raphael.Shared.csproj" />
    <ProjectReference Include="..\Raphael.Shared\Raphael.Shared.csproj" />
  </ItemGroup>
  
  <PropertyGroup>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn> <!-- Hide missing comment warnings -->
  </PropertyGroup>

</Project>

